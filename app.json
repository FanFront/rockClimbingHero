{
  "expo": {
    "name": "Rock Climbing Hero",
    "slug": "rock-climbing-hero",
    "scheme": "rockclimbinghero",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.fanfront.rockclimbinghero",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "extra": {
      "appTheme": "ASCENT Expedition RPG"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": "Allow ASCENT to photograph a climbing route for your AI question."
        }
      ]
    ]
  }
}
